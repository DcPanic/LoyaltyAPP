# ---------------------------------------------------------------- core ------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyaltyapp
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MEMBER_TOKEN_TTL_DAYS=730
LOG_LEVEL=info

# -------------------------------------------------- Apple Wallet (ours) -----
# From the Apple Developer portal: a Pass Type ID, its certificate, and the
# Apple WWDR intermediate certificate. No third-party pass provider is used.
APPLE_PASS_TYPE_IDENTIFIER=pass.com.yourcompany.loyaltyapp
APPLE_TEAM_IDENTIFIER=ABCDE12345
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM=
APPLE_APNS_TOPIC=pass.com.yourcompany.loyaltyapp
APPLE_APNS_HOST=https://api.push.apple.com

# ------------------------------------------------- Google Wallet (ours) -----
# Google Wallet API issuer account + service account with the
# wallet_object.issuer scope.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=

# ------------------------------------------ image uploads (Supabase) -------
# Where the café's logo, cover and reward pictures are stored. Without these
# the dashboard still accepts a picture's address, it just cannot take a file.
# The service key is server-side only and never reaches a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_MEDIA_BUCKET=media

# ------------------------------------------------------------- billing -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---------------------------------------------------- email (Resend) -------
# Without a key nothing is sent: confirmation links are handed back to the
# caller instead, so signing up still works. https://resend.com — free tier.
RESEND_API_KEY=
MAIL_FROM=LoyaltyApp <onboarding@resend.dev>

# ------------------------------------------- signing in with Google --------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Redirect URI: <API_URL>/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -------------------------------------------- signing in with Apple --------
# Needs a paid Apple Developer account, the same one Apple Wallet uses.
# APPLE_SIGNIN_CLIENT_ID is the Services ID, not the app's bundle id.
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
